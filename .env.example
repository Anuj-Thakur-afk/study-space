# StudySpace — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Obtain these from Google Cloud Console:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or select an existing one)
#   3. Enable the "Google+ API" or "People API"
#   4. Go to APIs & Services > Credentials
#   5. Create OAuth 2.0 Client ID (Application type: Web application)
#   6. Add authorized JavaScript origin: http://localhost:3000
#   7. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
#      (For production, also add your production domain)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Next.js ──────────────────────────────────────────────────────────────────
NODE_ENV=development
